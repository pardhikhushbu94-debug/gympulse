# ==============================================================================
# GymPulse - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values.
# NEVER commit your production secret keys into version control.

# ------------------------------------------------------------------------------
# 1. Supabase Backend (Auth, Database, RLS, Storage)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Server-only (Used exclusively inside Supabase Edge Functions / Backend):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Razorpay Payments (UPI, Cards, Netbanking & Subscriptions)
# ------------------------------------------------------------------------------
# Public Key (Safe to bundle in client app for Razorpay Standard Checkout):
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId1234
# Secret Key (Used ONLY by server-side Edge Functions for webhook HMAC verification):
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_passphrase

# ------------------------------------------------------------------------------
# 3. Gym Geofencing & Location (Attendance Anti-Fraud)
# ------------------------------------------------------------------------------
# GPS coordinates of the gym entrance:
EXPO_PUBLIC_GYM_LATITUDE=19.0596
EXPO_PUBLIC_GYM_LONGITUDE=72.8295
# Tolerance radius in meters (default: 50m):
EXPO_PUBLIC_GEOFENCE_RADIUS_METERS=50
# TOTP QR Rotation Interval in seconds (default: 30s):
EXPO_PUBLIC_QR_ROTATION_SECONDS=30

# ------------------------------------------------------------------------------
# 4. Video Streaming & Storage (Cloudflare Stream / Mux)
# ------------------------------------------------------------------------------
CLOUDFLARE_STREAM_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token
# Fallback to Supabase Storage Bucket for small attachments:
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=gym-media

# ------------------------------------------------------------------------------
# 5. Push Notifications & SMS / WhatsApp (MSG91 / Twilio)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_PROJECT_ID=your-eas-project-uuid-here
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WHATSAPP_SENDER=919820012345
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# ------------------------------------------------------------------------------
# 6. Deep Linking & App Scheme
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_SCHEME=gympulse
