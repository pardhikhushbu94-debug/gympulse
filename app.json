{
  "expo": {
    "name": "GymPulse",
    "slug": "gympulse",
    "scheme": "gympulse",
    "version": "1.0.0",
    "description": "GymPulse - Enterprise Indian Gym Management, Attendance & Fitness App",
    "orientation": "portrait",
    "primaryColor": "#CCFF00",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ironcore.gympulse"
    },
    "android": {
      "package": "in.ironcore.gympulse",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/gympulse"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
